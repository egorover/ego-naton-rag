        ],
        "webhookId": "pinecone-search-webhook"
      },
      {
        "parameters": {
          "functionCode": "const inputItem = $input.item;\nconst body = inputItem?.json?.body || inputItem?.json || {};\n\nconst query = body.query || body.body?.query;\n\nif (!query || typeof query !== 'string') {\n  throw new Error(`Query field is required. Received: ${JSON.stringify(body)}`);\n}\n\nreturn [{\n  json: {\n    query: query,\n    namespace: body.namespace || 'default'\n  }\n}];"
        },
        "id": "a501cd2b-063c-438c-a48e-cc9b054655bb",
        "name": "Process Query",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [
          224,
          0
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ 'https://n8n-ai-index-1pi8qek.svc.aped-4627-b74a.pinecone.io/namespaces/' + encodeURIComponent($('Process Query').item.json.namespace) + '/documents/search' }}",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "X-Pinecone-Api-Version",
                "value": "2026-07"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ {\n  \"score_by\": [{\n    \"type\": \"embed\",\n    \"fields\": [\"chunk_text\"],\n    \"query\": $('Process Query').item.json.query\n  }],\n  \"top_k\": 5,\n  \"include_fields\": [\"chunk_text\", \"title\", \"source\", \"chunk_index\"]\n} }}",
          "options": {}
        },
        "id": "99998a96-28e3-4f83-a820-181bde737314",
        "name": "Query Pinecone",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [
          448,
          0
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "tLksH8FaxQcpV95M",
            "name": "Pinecone Header Auth"
          }
        }
      },
      {
        "parameters": {
          "functionCode": "const response = $input.item.json || {};\nconst hits = response.result?.hits || response.hits || response.result?.matches || response.matches || [];\n\nif (!Array.isArray(hits)) {\n  throw new Error(`Invalid Pinecone document-search response: ${JSON.stringify(response)}`);\n}\n\nconst results = hits.map(hit => {\n  const fields = hit.fields || hit.metadata || hit;\n  return {\n    text: fields.chunk_text || fields.text || fields.content || '',\n    score: hit._score ?? hit.score ?? 0,\n    source: fields.source || fields.title || 'unknown',\n    chunk_index: fields.chunk_index ?? -1,\n    id: hit._id || hit.id || ''\n  };\n});\n\nreturn [{\n  json: {\n    results,\n    context: results.map(result => result.text).filter(Boolean).join('\\n\\n')\n  }\n}];"
        },
        "id": "2fd856b6-cba5-44b3-a156-2f316ef340e9",
